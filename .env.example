# What the admin reads from its env file. Copy it to .env.local and fill it in; env files never
# go to the repository.

# The admin's own address, as the browser opens it. Over https, the session cookies are secure.
NEXTAUTH_URL=http://localhost:3001
# Signs the session cookies: a long random value of each server's own. Make one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXTAUTH_SECRET=

# muatle-backend's API, version prefix included. Its CORS_ALLOWED_ORIGINS must list this
# admin's address (NEXTAUTH_URL), since the browser calls the API directly.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000/api/v1
# Where the businesses' panel lives, to open a business's digital menu from here
NEXT_PUBLIC_PANEL_URL=http://localhost:3000
